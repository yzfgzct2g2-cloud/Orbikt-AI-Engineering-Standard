{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaes.dev/schemas/action.schema.json",
  "title": "OAES v2 Action",
  "type": "object",
  "required": ["id", "actor", "target_knowledge", "description", "created_at"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "target_knowledge": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["establish", "implement", "verify", "invalidate"] },
    "rationale": { "type": "string" },
    "resulting_state": { "enum": ["Unknown", "Known", "Implemented", "Verified"] }
  }
}
