{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaes.dev/schemas/knowledge.schema.json",
  "title": "OAES v2 Knowledge",
  "type": "object",
  "required": ["id", "type", "content", "state", "parent", "depends_on", "source", "updated_at"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "state": { "enum": ["Unknown", "Known", "Implemented", "Verified"] },
    "parent": { "type": ["string", "null"] },
    "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "requires_implementation": { "type": "boolean" }
  }
}
