{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaes.dev/schemas/project.schema.json",
  "title": "OAES v2 Persisted Project",
  "type": "object",
  "required": ["format", "format_version", "objective", "actors", "knowledge", "actions", "checkpoint"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "oaes-project" },
    "format_version": { "const": "2.0.0" },
    "objective": { "$ref": "objective.schema.json" },
    "actors": { "type": "array", "minItems": 1, "items": { "$ref": "actor.schema.json" } },
    "knowledge": { "type": "array", "items": { "$ref": "knowledge.schema.json" } },
    "actions": { "type": "array", "items": { "$ref": "action.schema.json" } },
    "checkpoint": {
      "type": "object",
      "required": ["pending_action", "updated_at"],
      "additionalProperties": true,
      "properties": {
        "pending_action": { "type": ["string", "null"] },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
